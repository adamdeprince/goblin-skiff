# Modified for Goblin Skiff on 2026-09-19.
# Bash completions for goblin-skiff, the mobile shell.       -*- shell-script -*-

__goblin_skiff_init_completion()
{
    if declare -F _init_completions >/dev/null 2>&1; then
        _init_completion
    else
        COMPREPLY=()
        _get_comp_words_by_ref cur prev words cword
    fi
}

_goblin_skiff () {
    local cur

    __goblin_skiff_init_completion || return

    local simple_flags="-a -b -4 -6 -p -J"
    local flags="--client= --server= --predict= --family= --port=
    --connect-timeout= --bind-server= --ssh= --fips-crypto --tmux-control --native-scroll --alternate-screen
    --jump= --jump-server= --jump-port= --jump-idle-timeout=
    --mascot= --no-mascot --no-kitty --no-sixel
    --lossy= --djvu-lossy
    --init --no-init --help --version"

    if [[ "$cur" == --* && "$COMP_CWORD" == 1 ]]; then
        COMPREPLY=($(compgen -W "$flags" -- "$cur"))
    elif [[ "$cur" == -* && "$COMP_CWORD" == 1 ]]; then
        COMPREPLY=($(compgen -W "$simple_flags" -- "$cur"))
    else
        _known_hosts_real -a "$cur"
    fi
}

complete -o nospace -F _goblin_skiff goblin-skiff
