# --------------------------------------------------------------- preflight

def github_refs():
    """Return the commit ids advertised by the public GitHub repository, or fail.

    Credential helpers and prompts are disabled, so this only succeeds for a
    repository that anyone can read.
    """
    url = 'https://github.com/%s.git' % PROJECT['github']
    env = dict(os.environ, GIT_TERMINAL_PROMPT='0', GIT_ASKPASS='/bin/false', SSH_ASKPASS='/bin/false')
    try:
        listing = output('git', '-c', 'credential.helper=', '-c', 'core.askPass=/bin/false',
                         'ls-remote', url, env=env, stderr=subprocess.PIPE)
    except subprocess.CalledProcessError:
        raise DeployError(url + ' is not publicly readable. Only public repositories are deployed.')
    return {line.split()[0] for line in listing.splitlines() if line.strip()}


def check_public(allow_unpublished):
    refs = github_refs()
    log('upstream is public: https://github.com/' + PROJECT['github'])
    if not is_git_checkout():
        log('WARNING: %s is not a git checkout; cannot confirm the source matches GitHub.' % ROOT)
        return None
    head = output('git', '-C', ROOT, 'rev-parse', 'HEAD')
    published = head in refs
    for sha in sorted(refs):
        if published:
            break
        known = subprocess.run(['git', '-C', str(ROOT), 'cat-file', '-e', sha + '^{commit}'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        published = known and subprocess.run(
            ['git', '-C', str(ROOT), 'merge-base', '--is-ancestor', head, sha]).returncode == 0
    if not published:
        message = ('HEAD %s is not on https://github.com/%s (push it, or git fetch if it is already there)'
                   % (head[:12], PROJECT['github']))
        if not allow_unpublished:
            raise DeployError(message + '. Pass --allow-unpublished to deploy anyway.')
        log('WARNING:', message)
    return head


