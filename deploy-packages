class DeployError(RuntimeError):
    pass


# ---------------------------------------------------------------- utilities

def log(*parts):
    print('deploy-packages:', *parts, flush=True)


def run(*command, **kwargs):
    return subprocess.run([str(x) for x in command], check=True, **kwargs)


def output(*command, **kwargs):
    return run(*command, text=True, stdout=subprocess.PIPE, **kwargs).stdout.strip()


def digest(path):
    result = hashlib.sha256()
    with Path(path).open('rb') as stream:
        while True:
            block = stream.read(1 << 20)  # Streaming chunk size, not an input limit.
            if not block:
                return result.hexdigest()
            result.update(block)


def write_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.new')
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')
    temporary.replace(path)


def read_json(path):
    return json.loads(Path(path).read_text())


def now():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def brew_version(version):
    # Debian marks local version suffixes with +; Homebrew and file names use -.
    return version.replace('+', '-').replace('~', '-')


def extract_archive(archive, destination):
    with tarfile.open(archive) as tar:
        if hasattr(tarfile, 'data_filter'):
            tar.extractall(destination, filter='data')
        else:
            tar.extractall(destination)


def is_git_checkout():
    try:
        top = output('git', '-C', ROOT, 'rev-parse', '--show-toplevel', stderr=subprocess.DEVNULL)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False
    return Path(top).resolve() == ROOT


def project_version(allow_dirty=False):
    """VERSION is (file, regex); the regex's non-empty groups are joined with +.

    The committed file is read, matching the snapshot that will be built,
    unless --allow-dirty publishes the working tree.
    """
    filename, pattern = PROJECT['version']
    if is_git_checkout() and not allow_dirty:
        try:
            text = output('git', '-C', ROOT, 'show', 'HEAD:' + filename, stderr=subprocess.PIPE)
        except subprocess.CalledProcessError:
            raise DeployError('%s is not committed; the release source is the committed tree' % filename)
    else:
        text = (ROOT / filename).read_text()
    match = re.search(pattern, text, re.M)
    if not match:
        raise DeployError('Cannot find the version in %s with %r' % (filename, pattern))
    version = '+'.join(g.strip() for g in match.groups() if g)
    if not re.fullmatch(r'[0-9][0-9A-Za-z.+~-]*', version):
        raise DeployError('Unusable version string: %r' % version)
    return version


def maintainer():
    value = os.environ.get('DEPLOY_MAINTAINER')
