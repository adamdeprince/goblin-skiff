def mirror_digests(paths):
    """sha256 of files on hail's mirror; None for missing files."""
    script = 'for f in "$@"; do if [ -f "$f" ]; then sha256sum "$f"; else echo "- $f"; fi; done'
    listing = output(*ssh_base({}), PUBLISHER['ssh'], shlex.join(['bash', '-c', script, 'mirror'] + paths))
    digests = {}
    for line in listing.splitlines():
        value, path = line.split(None, 1)
        digests[path] = None if value == '-' else value
    return digests


def check_mirror_matches_r2(r2, builds):
    """The hail mirror must equal live R2 metadata, or merging would drop releases."""
    checks = {(APT_SITE, k) for k in CATALOG_FILES} | {(BREW_SITE, k) for k in CATALOG_FILES}
    checks.add((BREW_SITE, 'homebrew-tap.git/info/refs'))
    for info in builds.values():
        if info['kind'] == 'deb':
            checks.add((APT_SITE, 'dists/%s/InRelease' % info['suite']))
    checks = sorted(checks)
    paths = ['%s/%s/%s' % (PUBLISHER['mount'], site, key) for site, key in checks]
    mirror = mirror_digests(paths)
    expected = {}
    for (site, key), path in zip(checks, paths):
        live = r2.sha256(site, key)
        if live != mirror.get(path):
            raise DeployError('hail:%s differs from the live https://%s/%s.\nReconcile the mirror with R2 '
                              'before publishing; nothing was changed.' % (path, site, key))
        expected[(site, key)] = live
    return expected


def command_publish(args, stage=None, release=None):
    if stage is None:
        stage, release = load_stage(args)
    if (stage / 'published.json').exists():
        raise DeployError('Already published: ' + str(stage))
    targets = selected_targets(args.skip_host)
    builds = validate_stage(stage, release, targets)
    for target in args.skip_host or ():
        log('WARNING: not publishing %s (--skip-host)' % target)
    log('%s %s is ready to publish:' % (release['name'], release['version']))
    for target in targets:
        info = builds[target]
        files = [d['file'] for d in info.get('debs', [])] + [e['file'] for e in info.get('brew', [])]
        log('  %-10s %s' % (target, ', '.join(files)))
    if args.check:
        log('the stage is complete and consistent (--check: nothing uploaded)')
        return
    if not args.yes:
        if not sys.stdin.isatty():
            raise DeployError('Refusing to publish without confirmation; pass --yes')
        answer = input('Publish to https://%s/ and https://%s/? [y/N] ' % (BREW_SITE, APT_SITE))
        if answer.strip().lower() not in ('y', 'yes'):
            raise DeployError('Not published')
    r2 = R2()
    expected = check_mirror_matches_r2(r2, builds)
    release['publish_targets'] = targets
    write_json(stage / 'release.json', release)
    shutil.copy2(Path(__file__).resolve(), stage / 'deploy-packages')
    identity = release_identity(release)
    remote = '%s/%s/.incoming/%s/' % (PUBLISHER['mount'], APT_SITE, identity)
    run(*ssh_base({}), PUBLISHER['ssh'], shlex.join(['mkdir', '-p', remote]))
    rsync_host = os.environ.get('GOBLIN_RSYNC_HOST', PUBLISHER['rsync_host'])
    upload = [stage / 'release.json', stage / 'deploy-packages', stage / 'source'] + [stage / t for t in targets]
    # .incoming is a hidden area of the mirror; it is never uploaded to R2.
    run('rsync', '-a', '--checksum', *upload,
        '%s::%s/%s/.incoming/%s/' % (rsync_host, PUBLISHER['rsync_module'], APT_SITE, identity))
    run(*ssh_base({}), PUBLISHER['ssh'],
        shlex.join(['python3', remote + 'deploy-packages', 'hail-publish', '--stage', remote]))
    r2_root = stage / 'r2'
    if r2_root.exists():
        shutil.rmtree(r2_root)
    changed = {}
    for site in (APT_SITE, BREW_SITE):
        keys_file = stage / ('r2-keys-%s.json' % site)
        run('rsync', '-a', '-e', rsync_ssh({}), '%s:%s%s' % (PUBLISHER['ssh'], remote, keys_file.name), str(keys_file))
        keys = read_json(keys_file)
        if not keys:
            continue
        listing = stage / ('r2-keys-%s.txt' % site)
        listing.write_text(''.join(k + '\n' for k in keys))
        (r2_root / site).mkdir(parents=True)
        run('rsync', '-a', '--files-from=' + str(listing), '-e', rsync_ssh({}),
            '%s:%s/%s/' % (PUBLISHER['ssh'], PUBLISHER['mount'], site), str(r2_root / site) + '/')
        changed[site] = r2_upload(r2, site, r2_root / site, keys, expected[(site, 'packages.json')])
    for site in changed:
        want = digest(r2_root / site / 'packages.json')
        try:
            got = public_sha256(site, 'packages.json')
        except OSError as error:
            got = 'unavailable (%s)' % error
        if got == want:
            log('verified https://%s/packages.json' % site)
        else:
            log('WARNING: https://%s/packages.json does not match the upload yet (CDN cache?)' % site)
    write_json(stage / 'published.json', {'published': now(), 'targets': targets, 'r2_changed': changed})
    log('published %s %s. Index pages and READMEs on the sites were not edited.' % (release['name'], release['version']))


