class R2:
    """Cloudflare R2 object API; the token is read into memory only."""

    def __init__(self):
        path = Path(os.environ.get('GOBLIN_R2_CONFIG', R2_CONFIG)).expanduser()
        if not path.exists():
            raise DeployError('Missing %s ({"account_id": "...", "token_file": "~/r2-god.txt"})' % path)
        config = read_json(path)
        self.account = config['account_id']
        self.token = Path(config.get('token_file', '~/r2-god.txt')).expanduser().read_text().strip()
        self.buckets = config.get('buckets', {})

    def request(self, method, site, key, body=None, headers=None):
        bucket = self.buckets.get(site, 'site-' + site.replace('.', '-'))
        url = ('https://api.cloudflare.com/client/v4/accounts/%s/r2/buckets/%s/objects/%s'
               % (self.account, bucket, quote(key, safe='/')))
        request = Request(url, data=body, method=method,
                          headers=dict({'Authorization': 'Bearer ' + self.token}, **(headers or {})))
        try:
            return urlopen(request, timeout=300)
        except HTTPError as error:
            if error.code == 404 and method == 'GET':
                return None
            try:
                details = json.load(error).get('errors', [])
            except ValueError:
                details = []
            raise DeployError('R2 %s %s/%s: HTTP %d %s' % (method, site, key, error.code, details)) from None

    def sha256(self, site, key):
        response = self.request('GET', site, key)
        if response is None:
            return None
        result = hashlib.sha256()
        with response:
            while True:
                block = response.read(1 << 20)  # Streaming chunk size, not an input limit.
                if not block:
                    return result.hexdigest()
                result.update(block)

    def put(self, site, key, path):
        with path.open('rb') as stream:
            self.request('PUT', site, key, stream, {
                'Content-Type': content_type(key), 'Cache-Control': 'no-cache',
                'Content-Length': str(path.stat().st_size)}).close()


def content_type(key):
    if key.endswith(('.rb', '.asc')) or key.rsplit('/', 1)[-1] in ('InRelease', 'Release', 'Packages', 'SHA256SUMS'):
        return 'text/plain; charset=utf-8'
    if key.endswith('.md'):
        return 'text/markdown; charset=utf-8'
    kind = mimetypes.guess_type(key)[0] or 'application/octet-stream'
    if key.endswith(('.html', '.css', '.txt', '.json')):
        kind += '; charset=utf-8'
    return kind


def upload_priority(key):
    if key.startswith('homebrew-tap.git/'):
        return 0 if key.startswith('homebrew-tap.git/objects/') else 2
    if key.startswith('dists/'):
        return 2 if key.endswith(('InRelease', '/Release', 'Release.gpg')) else 1
    if key in CATALOG_FILES:
        return 3
    return 0


def r2_upload(r2, site, root, keys, expected_catalog):
    """Upload in dependency order: artifacts, indexes, signed indexes, catalog."""
    lock = threading.Lock()
    changed = []

    def one(key):
        path = root / key
        local = digest(path)
        remote = r2.sha256(site, key)
        if remote == local:
            return
        if remote is not None and key.startswith(IMMUTABLE_PREFIXES):
            raise DeployError('Refusing to replace published artifact %s/%s' % (site, key))
        r2.put(site, key, path)
        if r2.sha256(site, key) != local:
            raise DeployError('R2 verification failed for %s/%s' % (site, key))
        with lock:
            changed.append(key)
        log('uploaded %s/%s' % (site, key))

    for level in range(4):
        group = sorted(k for k in keys if upload_priority(k) == level)
        if not group:
            continue
        if level == 3:
            live = r2.sha256(site, 'packages.json')
            if live not in (expected_catalog, digest(root / 'packages.json')):
                raise DeployError('%s/packages.json changed during this publication. The new artifacts are '
                                  'uploaded but not yet listed; reconcile the catalog by hand.' % site)
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            list(pool.map(one, group))
    return sorted(changed)


def public_sha256(site, key):
    request = Request('https://%s/%s' % (site, key), headers={'Cache-Control': 'no-cache',
                                                             'User-Agent': 'deploy-packages'})
    result = hashlib.sha256()
    with urlopen(request, timeout=120) as response:
        while True:
            block = response.read(1 << 20)  # Streaming chunk size, not an input limit.
            if not block:
                return result.hexdigest()
            result.update(block)


