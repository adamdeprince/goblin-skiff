def deterministic_targz(directory, archive, mtime):
    """Write directory to archive with sorted entries and fixed metadata."""
    def normalize(info):
        info.uid = info.gid = 0
        info.uname = info.gname = 'root'
        info.mtime = mtime
        if info.isdir() or info.isfile():
            info.mode = 0o755 if (info.isdir() or info.mode & 0o111) else 0o644
        return info
    base = directory.parent
    paths = [directory] + sorted(directory.rglob('*'), key=lambda p: p.relative_to(base).as_posix())
    with archive.open('wb') as raw:
        with gzip.GzipFile(filename='', mode='wb', fileobj=raw, mtime=0, compresslevel=9) as compressed:
            with tarfile.open(fileobj=compressed, mode='w', format=tarfile.PAX_FORMAT) as tar:
                for path in paths:
                    tar.add(path, arcname=path.relative_to(base).as_posix(), recursive=False, filter=normalize)


def git_snapshot_commit(allow_dirty):
    """Return (HEAD, commit to archive, has uncommitted changes)."""
    head = output('git', '-C', ROOT, 'rev-parse', 'HEAD')
    status = output('git', '-C', ROOT, 'status', '--porcelain', '--untracked-files=normal')
    tracked = [line for line in status.splitlines() if not line.startswith('??')]
    untracked = [line for line in status.splitlines() if line.startswith('??')]
    if untracked:
        log('note: %d untracked file(s) are not part of the release source' % len(untracked))
    if not tracked:
        return head, head, False
    if not allow_dirty:
        raise DeployError('The working tree has uncommitted changes:\n  ' + '\n  '.join(tracked[:40]) +
                          ('\n  ...' if len(tracked) > 40 else '') +
                          '\nCommit and push them, or pass --allow-dirty to publish the working tree.')
    log('WARNING: publishing uncommitted changes to tracked files')
    with tempfile.TemporaryDirectory(prefix='deploy-index-') as temporary:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(temporary) / 'index'))
        run('git', '-C', ROOT, 'read-tree', 'HEAD', env=env)
        run('git', '-C', ROOT, 'add', '-u', env=env)
        tree = output('git', '-C', ROOT, 'write-tree', env=env)
        date = output('git', '-C', ROOT, 'log', '-1', '--format=%cI', 'HEAD')
        env.update(GIT_AUTHOR_NAME='deploy-packages', GIT_AUTHOR_EMAIL='deploy-packages@localhost',
                   GIT_COMMITTER_NAME='deploy-packages', GIT_COMMITTER_EMAIL='deploy-packages@localhost',
                   GIT_AUTHOR_DATE=date, GIT_COMMITTER_DATE=date)
        snapshot = output('git', '-C', ROOT, 'commit-tree', tree, '-p', head, '-m',
                          'deploy-packages working-tree snapshot', env=env)
    return head, snapshot, True


def make_source(version, allow_dirty, allow_unpublished):
    """Return (archive in a temporary directory, metadata)."""
    head = check_public(allow_unpublished)
    temporary = Path(tempfile.mkdtemp(prefix='deploy-source-'))
    prefix = '%s-%s' % (PROJECT['name'], brew_version(version))
    env = dict(os.environ, DEPLOY_NAME=PROJECT['name'], DEPLOY_VERSION=version,
               DEPLOY_BREW_VERSION=brew_version(version), DEPLOY_REPO=str(ROOT),
               DEPLOY_SOURCE_PREFIX=prefix)
    if PROJECT.get('source_command'):
        out = temporary / 'out'
        out.mkdir()
        env['DEPLOY_SOURCE_DIR'] = str(out)
        dirty = git_snapshot_commit(allow_dirty)[2] if head else None
        log('running SOURCE_COMMAND')
        run('bash', '-euo', 'pipefail', '-c', PROJECT['source_command'], cwd=ROOT, env=env)
        archives = sorted(out.glob('*.tar.gz'))
        if len(archives) != 1:
            raise DeployError('SOURCE_COMMAND must write exactly one .tar.gz to $DEPLOY_SOURCE_DIR')
        return archives[0], {'commit': head, 'snapshot_commit': None, 'dirty': dirty}
    if head is None:
        raise DeployError('Not a git checkout; this project needs a SOURCE_COMMAND.')
    if (ROOT / '.gitmodules').exists():
        raise DeployError('git snapshots do not include submodules; give this project a SOURCE_COMMAND.')
    head, snapshot, dirty = git_snapshot_commit(allow_dirty)
    tree = temporary / 'tree'
    tree.mkdir()
    exported = temporary / 'export.tar'
    with exported.open('wb') as stream:
        run('git', '-C', ROOT, 'archive', '--format=tar', '--prefix=' + prefix + '/', snapshot, stdout=stream)
    extract_archive(exported, tree)
    exported.unlink()
    source_root = tree / prefix
    if PROJECT.get('source_hook'):
        log('running SOURCE_HOOK in the snapshot')
        run('bash', '-euo', 'pipefail', '-c', PROJECT['source_hook'], cwd=source_root, env=env)
    mtime = int(output('git', '-C', ROOT, 'log', '-1', '--format=%ct', 'HEAD'))
    result = temporary / (prefix + '.tar.gz')
    deterministic_targz(source_root, result, mtime)
    shutil.rmtree(tree)
    return result, {'commit': head, 'snapshot_commit': snapshot, 'dirty': dirty}


def stage_path(args, version):
    if args.stage:
        return Path(args.stage).expanduser().resolve()
    return deploy_root() / brew_version(version)


def command_source(args):
    version = project_version(args.allow_dirty)
    stage = stage_path(args, version)
    if (stage / 'published.json').exists():
        raise DeployError('%s %s is already published (%s). Bump the version first.'
                          % (PROJECT['name'], version, stage))
    if args.fresh and stage.exists():
        log('discarding unpublished stage', stage)
        shutil.rmtree(stage)
    archive, meta = make_source(version, args.allow_dirty, args.allow_unpublished)
    sha = digest(archive)
    release_file = stage / 'release.json'
    if release_file.exists():
        release = read_json(release_file)
        shutil.rmtree(archive.parent, ignore_errors=True)
        if release['source']['sha256'] != sha:
            raise DeployError('A different source for %s %s is already staged in %s.\n'
                              'Bump the version, or pass --fresh to discard that unpublished stage.'
                              % (PROJECT['name'], version, stage))
        log('reusing staged source', stage / 'source' / release['source']['file'])
        return stage, release
    (stage / 'source').mkdir(parents=True, exist_ok=True)
    destination = stage / 'source' / archive.name
    shutil.move(str(archive), str(destination))
    shutil.rmtree(archive.parent, ignore_errors=True)
    (stage / 'source' / (archive.name + '.sha256')).write_text(sha + '  ' + archive.name + '\n')
    release = {
        'name': PROJECT['name'], 'version': version, 'brew_version': brew_version(version),
        'github': 'https://github.com/' + PROJECT['github'], 'license': PROJECT['license'],
        'homepage': PROJECT.get('homepage', ''), 'debs': PROJECT.get('debs', []),
        'brew': PROJECT.get('brew', {}), 'unsupported': unsupported_targets(),
        'maintainer': maintainer(),
        'source': {'file': archive.name, 'sha256': sha, 'size': destination.stat().st_size},
        'source_commit': meta['commit'], 'snapshot_commit': meta['snapshot_commit'],
        'source_has_uncommitted_changes': meta['dirty'], 'created': now(),
        'driver_version': DRIVER_VERSION,
    }
    write_json(release_file, release)
    log('source', destination)
    log('sha256', sha)
    return stage, release


def load_stage(args):
    version = project_version(args.allow_dirty)
    stage = stage_path(args, version)
    if not (stage / 'release.json').exists():
        raise DeployError('No staged source for %s %s in %s; run ./deploy-packages source first.'
                          % (PROJECT['name'], version, stage))
    return stage, read_json(stage / 'release.json')


