def immutable_copy(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if digest(source) != digest(destination):
            raise DeployError('A different file is already published at ' + str(destination))
        return
    with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False) as stream:
        temporary = Path(stream.name)
        with source.open('rb') as content:
            shutil.copyfileobj(content, stream)
    temporary.chmod(0o644)
    temporary.replace(destination)


def reprepro_distributions(conf):
    result, codename = {}, None
    for line in (conf / 'distributions').read_text().splitlines():
        if ':' not in line:
            continue
        key, value = (x.strip() for x in line.split(':', 1))
        if key == 'Codename':
            codename = value
            result[codename] = set()
        elif key == 'Architectures' and codename:
            result[codename] = set(value.split())
    return result


def tree_state(directory):
    if not directory.exists():
        return {}
    return {p.relative_to(directory).as_posix(): (p.stat().st_size, p.stat().st_mtime_ns)
            for p in directory.rglob('*') if p.is_file()}


def site_artifact(site, path):
    relative = path.relative_to(site).as_posix()
    return {'path': relative, 'url': 'https://%s/%s' % (site.name, relative), 'filename': path.name,
            'size': path.stat().st_size, 'sha256': digest(path)}


def sign_catalog(admin, site, catalog, stage):
    candidate = stage / (site.name + '-packages.json')
    candidate.write_text(json.dumps(catalog, indent=2) + '\n')
    signature = stage / (site.name + '-packages.json.asc')
    run('gpg', '--homedir', admin / 'gnupg', '--batch', '--yes', '--local-user', SIGNING_KEY,
        '--armor', '--detach-sign', '--output', signature, candidate)
    run('gpgv', '--keyring', site / 'goblinreactor-archive-keyring.gpg', signature, candidate)
    for source, destination in ((candidate, site / 'packages.json'), (signature, site / 'packages.json.asc')):
        temporary = destination.with_name(destination.name + '.deploy-new')
        shutil.copy2(source, temporary)
        temporary.replace(destination)


def version_greater(new, old):
    return subprocess.run(['dpkg', '--compare-versions', new, 'gt', old]).returncode == 0


def check_apt_targets(stage, builds, linux, distributions, catalog, conf):
    for target in linux:
        info = builds[target]
        if info['suite'] not in distributions:
            raise DeployError('reprepro has no %s suite; add it to %s first' % (info['suite'], conf))
        for deb in info['debs']:
            if deb['architecture'] != 'all' and deb['architecture'] not in distributions[info['suite']]:
                raise DeployError('reprepro suite %s lacks architecture %s' % (info['suite'], deb['architecture']))
            path = stage / target / deb['file']
            for field, value in (('Package', deb['package']), ('Version', deb['version']),
                                 ('Architecture', deb['architecture'])):
                if output('dpkg-deb', '-f', path, field) != value:
                    raise DeployError('%s: the %s field does not match the build record' % (deb['file'], field))
            for record in catalog['packages']:
                if (record.get('name'), record.get('suite'), record.get('architecture')) != (
                        deb['package'], info['suite'], deb['architecture']):
                    continue
                old = record.get('version', '0')
                if old != deb['version'] and not version_greater(deb['version'], old):
                    raise DeployError('%s %s is not newer than the published %s for %s/%s; bump the version'
                                      % (deb['package'], deb['version'], old, info['suite'], deb['architecture']))


def command_hail_publish(args):
    stage = Path(args.stage).resolve()
    release = read_json(stage / 'release.json')
    targets = release['publish_targets']
    builds = validate_stage(stage, release, targets)
    admin, mount = Path(args.admin), Path(args.mount)
    apt, brew = mount / APT_SITE, mount / BREW_SITE
    name = release['name']
    for tool in ('reprepro', 'gpg', 'gpgv', 'dpkg-deb', 'git'):
        if not shutil.which(tool):
            raise DeployError('hail is missing ' + tool)
    run('gpg', '--homedir', admin / 'gnupg', '--batch', '--list-secret-keys', SIGNING_KEY, stdout=subprocess.DEVNULL)
    linux = [t for t in targets if builds[t]['kind'] == 'deb']
    conf = admin / 'reprepro/conf'
    check_apt_targets(stage, builds, linux, reprepro_distributions(conf), read_json(apt / 'packages.json'), conf)
    source = stage / 'source' / release['source']['file']
    keys = {APT_SITE: set(), BREW_SITE: set()}
    common = {'source_snapshot_sha256': release['source']['sha256'], 'source_commit': release['source_commit'],
              'source_has_uncommitted_changes': release['source_has_uncommitted_changes'],
              'license': release['license'], 'upstream': release['github'],
              'verification': {'native_build': 'passed', 'public_install': 'pending'},
              'published_by': 'deploy-packages %d' % DRIVER_VERSION}
    with contextlib.ExitStack() as stack:
        # The same locks every Goblin publisher takes.
        for site in ('apt', 'brew'):
            lock = stack.enter_context((admin / (site + '-publish.lock')).open('a'))
            fcntl.flock(lock, fcntl.LOCK_EX)
        backup = admin / 'deploy-packages-backups' / (name + '-' + datetime.datetime.now(
            datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ'))
        backup.mkdir(parents=True, mode=0o700)
        for site in (apt, brew):
            (backup / site.name).mkdir()
            for filename in CATALOG_FILES:
                shutil.copy2(site / filename, backup / site.name / filename)
        shutil.copytree(admin / 'reprepro/db', backup / 'reprepro-db')
        shutil.copytree(conf, backup / 'reprepro-conf')
        shutil.copytree(apt / 'dists', backup / 'apt-dists', symlinks=True)
        tap = brew / 'homebrew-tap.git'
        git = ['git', '-c', 'safe.directory=' + str(tap)]
        (backup / 'tap-main.txt').write_text(output(*git, '--git-dir', tap, 'rev-parse', 'refs/heads/main') + '\n')
        log('backup', backup)
        for site in (apt, brew):
            immutable_copy(source, site / 'sources' / source.name)
            keys[site.name].add('sources/' + source.name)

        brew_records = []
        if 'localhost' in targets:
            info = builds['localhost']
            release_dir = brew / 'releases' / ('%s-%s' % (name, release['brew_version']))
            files = []
            for item in info['artifacts']:
                immutable_copy(stage / 'localhost' / item['file'], release_dir / item['file'])
                files.append(release_dir / item['file'])
            immutable_copy(stage / 'localhost' / 'deploy-build.json', release_dir / 'deploy-build.json')
            files.append(release_dir / 'deploy-build.json')
            tap_before = tree_state(tap)
            with tempfile.TemporaryDirectory(prefix='deploy-tap-') as temporary:
                checkout = Path(temporary) / 'tap'
                run(*git, 'clone', '--quiet', tap, checkout)
                for entry in info['brew']:
                    folder = 'Casks' if entry['kind'] == 'cask' else 'Formula'
                    (checkout / folder).mkdir(exist_ok=True)
                    shutil.copy2(stage / 'localhost' / entry['file'], checkout / folder / entry['file'])
                    run('git', '-C', checkout, 'add', folder + '/' + entry['file'])
                if output('git', '-C', checkout, 'diff', '--cached', '--name-only'):
                    author = re.match(r'(.*?)\s*<([^>]*)>', release['maintainer'])
                    run('git', '-C', checkout, '-c', 'user.name=' + author.group(1), '-c', 'user.email=' + author.group(2),
                        'commit', '--quiet', '-m', 'Release %s %s' % (name, release['brew_version']))
                parent = output(*git, '--git-dir', tap, 'rev-parse', 'refs/heads/main')
                run('git', '-C', checkout, 'merge-base', '--is-ancestor', parent, 'HEAD')
                run(*git, '--git-dir', tap, 'fetch', '--quiet', '--no-tags', checkout, 'refs/heads/main:refs/heads/main')
            run(*git, '--git-dir', tap, 'update-server-info')
            tap_after = tree_state(tap)
            keys[BREW_SITE].update('homebrew-tap.git/' + k for k, v in tap_after.items() if tap_before.get(k) != v)
            tap_commit = output(*git, '--git-dir', tap, 'rev-parse', 'refs/heads/main')
            for entry in info['brew']:
                record = dict(common, name=entry['name'], version=entry['version'],
                              format={'cask': 'homebrew-cask', 'bottle': 'homebrew-bottle',
                                      'formula': 'homebrew-binary'}[entry['kind']],
                              distribution=info['distribution'], architecture=info['architecture'],
                              platform_tag=info['platform_tag'], build_host='localhost', tap_commit=tap_commit,
                              source='https://%s/sources/%s' % (BREW_SITE, source.name),
                              artifacts=[site_artifact(brew, p) for p in files + [brew / 'sources' / source.name]])
                record['cask' if entry['kind'] == 'cask' else 'formula'] = TAP + '/' + entry['name']
                brew_records.append(record)
            keys[BREW_SITE].update(p.relative_to(brew).as_posix() for p in files)

        apt_records = []
        suites = set()
        dists_before = tree_state(apt / 'dists')
        env = dict(os.environ, GNUPGHOME=str(admin / 'gnupg'))
        included = set()
        for target in linux:
            info = builds[target]
            for deb in info['debs']:
                identity = (info['suite'], deb['package'], deb['version'], deb['architecture'])
                if deb['architecture'] == 'all' and identity in included:
                    log('%s: %s is already included from another host' % (target, deb['file']))
                    continue
                included.add(identity)
                run('reprepro', '--keepunreferencedfiles', '-b', admin / 'reprepro', '--export=never',
                    'includedeb', info['suite'], stage / target / deb['file'], env=env)
                suites.add(info['suite'])
                matches = [p for p in (apt / 'pool').rglob(deb['file']) if digest(p) == deb['sha256']]
                if len(matches) != 1:
                    raise DeployError('Cannot find %s in the pool after inclusion' % deb['file'])
                keys[APT_SITE].add(matches[0].relative_to(apt).as_posix())
                apt_records.append(dict(common, name=deb['package'], format='deb', suite=info['suite'],
                                        distribution=info['os'], architecture=deb['architecture'],
                                        version=deb['version'], depends=deb['depends'], build_host=target,
                                        source='https://%s/sources/%s' % (APT_SITE, source.name),
                                        artifacts=[site_artifact(apt, matches[0]),
                                                   site_artifact(apt, apt / 'sources' / source.name)]))
        if suites:
            reprepro = ['reprepro', '--keepunreferencedfiles', '-b', admin / 'reprepro']
            run(*reprepro, 'check', *sorted(suites), env=env)
            run(*reprepro, 'export', *sorted(suites), env=env)
            for suite in sorted(suites):
                run('gpgv', '--keyring', apt / 'goblinreactor-archive-keyring.gpg', apt / 'dists' / suite / 'InRelease')
            dists_after = tree_state(apt / 'dists')
            keys[APT_SITE].update('dists/' + k for k, v in dists_after.items() if dists_before.get(k) != v)

        def same_apt(a, b):
            return (a.get('name'), a.get('suite'), a.get('architecture')) == (b['name'], b['suite'], b['architecture'])

        def same_brew(a, b):
            return a.get('name') == b['name']

        for site, records, same in ((apt, apt_records, same_apt), (brew, brew_records, same_brew)):
            if not records:
                continue
            catalog = read_json(site / 'packages.json')
            catalog['packages'] = records + [old for old in catalog['packages']
                                             if not any(same(old, new) for new in records)]
            if site == brew:
                catalog['tap_commit'] = records[0]['tap_commit']
            artifacts = catalog.get('artifacts', [])
            inventory = {a['path']: a for a in artifacts if isinstance(a, dict) and 'path' in a}
            legacy = [a for a in artifacts if not (isinstance(a, dict) and 'path' in a)]
            for key in sorted(keys[site.name]):
                if not key.startswith('homebrew-tap.git/'):
                    inventory[key] = site_artifact(site, site / key)
            catalog['artifacts'] = legacy + sorted(inventory.values(), key=lambda a: a['path'])
            catalog['updated'] = now()
            sign_catalog(admin, site, catalog, stage)
            keys[site.name].update(CATALOG_FILES)
        for site_name, site_keys in keys.items():
            write_json(stage / ('r2-keys-%s.json' % site_name), sorted(site_keys))
        log('hail mirror updated: %d apt and %d brew files to upload'
            % (len(keys[APT_SITE]), len(keys[BREW_SITE])))


