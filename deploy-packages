def set_formula_line(text, key, value, after=None):
    pattern = re.compile(r'^  %s\s+"[^"]*".*$' % key, re.M)
    line = '  %s "%s"' % (key, value)
    if pattern.search(text):
        return pattern.sub(lambda _: line, text, count=1)
    if after is None:
        raise DeployError('The formula has no top-level %s line' % key)
    anchor = re.compile(r'^  %s\s+"[^"]*".*$' % after, re.M).search(text)
    return text[:anchor.end()] + '\n' + line + text[anchor.end():]


def command_brew_bottle(args):
    """MAC_BUILD helper: build, test and bottle a source formula in a scratch tap.

    The formula's stable url, sha256 and version are pointed at this release's
    source archive, which is not public yet, so Homebrew's download cache is
    seeded with it. Any previous bottle block and revision are removed. The
    bottled formula and the bottle are written to $DEPLOY_OUT, with root_url at
    this release's directory on brew.goblinreactor.com.
    """
    for key in ('DEPLOY_SOURCE', 'DEPLOY_SOURCE_URL', 'DEPLOY_SOURCE_SHA256', 'DEPLOY_BREW_URL',
                'DEPLOY_BREW_VERSION', 'DEPLOY_OUT'):
        if not os.environ.get(key):
            raise DeployError('brew-bottle runs from MAC_BUILD; %s is not set' % key)
    formula = Path(args.formula).resolve()
    name = formula.stem
    out = Path(os.environ['DEPLOY_OUT'])
    full = BUILD_TAP + '/' + name
    env = dict(os.environ, HOMEBREW_NO_INSTALL_FROM_API='1', HOMEBREW_NO_AUTO_UPDATE='1',
               HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK='1', HOMEBREW_NO_ENV_HINTS='1')
    installed = subprocess.run(['brew', 'list', '--formula', '--versions', name], env=env,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout.strip()
    if installed:
        raise DeployError('%s is installed (%s). Bottling needs it absent: brew uninstall %s, deploy, '
                          'then reinstall it.' % (name, installed, name))
    text = formula.read_text()
    text = set_formula_line(text, 'url', os.environ['DEPLOY_SOURCE_URL'])
    text = set_formula_line(text, 'sha256', os.environ['DEPLOY_SOURCE_SHA256'], after='url')
    text = set_formula_line(text, 'version', os.environ['DEPLOY_BREW_VERSION'], after='url')
    text = re.sub(r'^  bottle do\n.*?^  end\n\n?', '', text, flags=re.M | re.S)
    text = re.sub(r'^  revision\s+\d+\n', '', text, flags=re.M)
    user, repository = BUILD_TAP.split('/')
    tap_dir = Path(output('brew', '--repository', env=env)) / 'Library/Taps' / user / ('homebrew-' + repository)
    if tap_dir.exists():
        run('brew', 'untap', '--force', BUILD_TAP, env=env)
    run('brew', 'tap-new', '--no-git', BUILD_TAP, env=env, stdout=subprocess.DEVNULL)
    try:
        (tap_dir / 'Formula').mkdir(exist_ok=True)
        tapped = tap_dir / 'Formula' / formula.name
        tapped.write_text(text)
        cache = Path(output('brew', '--cache', '--build-from-source', full, env=env))
        cache.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(os.environ['DEPLOY_SOURCE'], cache)
        run('brew', 'install', '--build-bottle', '--formula', full, env=env)
        try:
            if re.search(r'^  test do', text, re.M):
                run('brew', 'test', full, env=env)
            with tempfile.TemporaryDirectory(prefix='deploy-bottle-') as temporary:
                work = Path(temporary)
                run('brew', 'bottle', '--json', '--root-url=' + os.environ['DEPLOY_BREW_URL'].rstrip('/'), full,
                    cwd=work, env=env)
                manifests = sorted(work.glob('*.bottle.json'))
                if len(manifests) != 1:
                    raise DeployError('brew bottle did not write one JSON manifest')
                run('brew', 'bottle', '--merge', '--write', '--no-commit', manifests[0], env=env)
                tags = next(iter(read_json(manifests[0]).values()))['bottle']['tags']
                if list(tags) != ['arm64_tahoe']:
                    raise DeployError('Unexpected bottle tags %s' % list(tags))
                tag = tags['arm64_tahoe']
                shutil.move(str(work / tag['local_filename']), str(out / tag['filename']))
                shutil.copy2(manifests[0], out / manifests[0].name)
            shutil.copy2(tapped, out / formula.name)
        finally:
            run('brew', 'uninstall', '--formula', '--ignore-dependencies', full, env=env)
    finally:
        run('brew', 'untap', '--force', BUILD_TAP, env=env)
    log('bottled', name)


# -------------------------------------------------------------------- plan

def command_plan(args):
    version = project_version(args.allow_dirty)
    log('project   %s %s (file/Homebrew version %s)' % (PROJECT['name'], version, brew_version(version)))
    log('upstream  https://github.com/%s' % PROJECT['github'])
    log('source    %s' % ('SOURCE_COMMAND' if PROJECT.get('source_command') else
                         'git snapshot of HEAD' + (' + SOURCE_HOOK' if PROJECT.get('source_hook') else '')))
    log('stage     %s' % stage_path(args, version))
    for target in TARGETS:
        if target in unsupported_targets():
            log('%-10s not built: %s' % (target, unsupported_targets()[target]))
        elif target == 'localhost':
            log('%-10s Homebrew %s' % (target, ', '.join('%s (%s)' % kv for kv in PROJECT['brew'].items())))
        else:
            log('%-10s apt via ssh %s: %s' % (target, host_config(target)['ssh'], ', '.join(PROJECT['debs'])))
    log('publish   hail mirror, then Cloudflare R2 for %s and %s' % (APT_SITE, BREW_SITE))


# -------------------------------------------------------------------- main

def main():
    parser = argparse.ArgumentParser(
        prog='deploy-packages',
        description='Build %s on naamah, graviton5, loongson and this Mac, then publish it to '
                    'https://%s/ and https://%s/. With no command: source, build, then publish.'
                    % (PROJECT['name'], BREW_SITE, APT_SITE))
    parser.add_argument('command', nargs='?', default='all',
                        choices=('all', 'plan', 'source', 'build', 'publish', 'hail-publish', 'brew-bottle'))
    parser.add_argument('formula', nargs='?', help=argparse.SUPPRESS)
    parser.add_argument('--host', action='append', choices=TARGETS, help='build only this target (repeatable)')
    parser.add_argument('--skip-host', action='append', choices=TARGETS,
                        help='build and publish without this target (repeatable)')
    parser.add_argument('--rebuild', action='store_true', help='rebuild targets that already have artifacts')
    parser.add_argument('--fresh', action='store_true', help='discard an unpublished stage for this version')
    parser.add_argument('--allow-dirty', action='store_true',
                        help='publish uncommitted changes to tracked files (recorded in the catalog)')
    parser.add_argument('--allow-unpublished', action='store_true',
                        help='deploy a HEAD that is not on the public GitHub repository yet')
    parser.add_argument('--deb-revision', type=int, default=1,
                        help='Debian revision for hooks that use $DEPLOY_DEB_REVISION (default 1)')
    parser.add_argument('--stage', help='stage directory (default ~/goblin-deploy/NAME/VERSION)')
    parser.add_argument('--check', action='store_true', help='publish: only validate the stage')
    parser.add_argument('--yes', action='store_true', help='publish without asking for confirmation')
    parser.add_argument('--admin', default=PUBLISHER['admin'], help=argparse.SUPPRESS)
    parser.add_argument('--mount', default=PUBLISHER['mount'], help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.host and args.skip_host:
        parser.error('use either --host or --skip-host')
    try:
        if args.command == 'plan':
            command_plan(args)
        elif args.command == 'source':
            command_source(args)
        elif args.command == 'build':
            command_build(args)
        elif args.command == 'publish':
            command_publish(args)
        elif args.command == 'hail-publish':
            command_hail_publish(args)
        elif args.command == 'brew-bottle':
            if not args.formula:
                parser.error('brew-bottle needs a formula path')
            command_brew_bottle(args)
        else:
            if args.host:
                parser.error('--host selects a subset; use it with the build command')
            stage, release = command_source(args)
            command_build(args, stage, release)
            command_publish(args, stage, release)
    except (DeployError, subprocess.CalledProcessError) as error:
        sys.exit('deploy-packages: error: %s' % error)
    except KeyboardInterrupt:
        sys.exit('deploy-packages: interrupted')


if __name__ == '__main__':
    main()
