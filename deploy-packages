        'DEPLOY_SOURCE_SHA256': release['source']['sha256'],
        'DEPLOY_SOURCE_URL': 'https://%s/sources/%s' % (BREW_SITE, release['source']['file']),
        'DEPLOY_BREW_URL': 'https://%s/releases/%s-%s/' % (BREW_SITE, release['name'], release['brew_version']),
        'DEPLOY_DEB_REVISION': str(release.get('deb_revision', 1)),
        'DEPLOY_MAINTAINER': release['maintainer'],
        'DEPLOY_HOMEPAGE': PROJECT.get('homepage', ''),
        'DEPLOY_DESCRIPTION': PROJECT.get('description', ''),
        'DEPLOY_GITHUB': 'https://github.com/' + PROJECT['github'],
        'DEPLOY_PYTHON': config.get('python', 'python3'),
    }
    if config.get('jobs'):
        env['DEPLOY_JOBS'] = str(config['jobs'])
    return env


def linux_script(release, target, config, remote_dir):
    archive = release['source']['file']
    lines = [
        '#!/bin/bash', 'set -euo pipefail', 'shopt -s nullglob',
        'cd "$HOME"/' + shlex.quote(remote_dir),
        'printf "%s  %s\\n" ' + shlex.quote(release['source']['sha256']) + ' ' + shlex.quote(archive) +
        ' | sha256sum -c -',
        'rm -rf src out work', 'mkdir -p src out work',
        'tar -xzf ' + shlex.quote(archive) + ' -C src',
        'set -- src/*/',
        'test "$#" -eq 1 || { echo "the source archive must have one top-level directory" >&2; exit 1; }',
        'export DEPLOY_OUT="$PWD/out" DEPLOY_WORK="$PWD/work" DEPLOY_SOURCE="$PWD/"' + shlex.quote(archive),
    ]
    for key, value in sorted(hook_environment(release, target, config).items()):
        lines.append('export %s=%s' % (key, shlex.quote(value)))
    lines.append('export DEPLOY_ARCH="$(dpkg --print-architecture)"')
    if config.get('suite'):
        lines.append('export DEPLOY_SUITE=' + shlex.quote(config['suite']))
    else:
        lines.append('export DEPLOY_SUITE="$(. /etc/os-release && printf %s "${VERSION_CODENAME:-}")"')
    lines.append('test -n "$DEPLOY_SUITE" || { echo "cannot determine the suite; set it in HOSTS" >&2; exit 1; }')
    if not config.get('jobs'):
        lines.append('export DEPLOY_JOBS="$(nproc)"')
    for key, value in config.get('env', {}).items():
        # Host environment values are expanded by the remote shell, so $PATH and $HOME work.
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key) or re.search(r'["`\\]', value):
            raise DeployError('Bad host environment entry for %s: %s' % (target, key))
        lines.append('export %s="%s"' % (key, value))
    lines.append(SHELL_HELPERS)
    lines.append('cd "$1"')
    lines.append('echo "deploy-packages: building on $(hostname) for $DEPLOY_SUITE/$DEPLOY_ARCH"')
    lines.append('(\n' + PROJECT['linux_build'].strip('\n') + '\n)')
    lines.append(COLLECT_DEBS)
    lines.append('cd "$HOME"/' + shlex.quote(remote_dir) + ' && rm -rf src work')
    return '\n'.join(lines) + '\n'


def parse_tsv(path):
    return [line.split('\t') for line in path.read_text().splitlines() if line]


def check_linux_build(release, info):
    target = info['target']
    packages = [d['package'] for d in info['debs']]
    for name in release['debs']:
        if packages.count(name) != 1:
            raise DeployError('%s: expected one %s package, found %d' % (target, name, packages.count(name)))
    extra = sorted(set(packages) - set(release['debs']))
    if extra:
        raise DeployError('%s: unexpected packages %s; list them in DEBS' % (target, ', '.join(extra)))
    for deb in info['debs']:
        if deb['architecture'] not in (info['architecture'], 'all'):
            raise DeployError('%s: %s has architecture %s on a %s host'
                              % (target, deb['file'], deb['architecture'], info['architecture']))


def build_linux(stage, release, target):
    config = host_config(target)
    destination = config['ssh']
    remote_dir = 'goblin-deploy/' + release_identity(release)
    out = stage / target
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    script = out / 'remote-build.sh'
    script.write_text(linux_script(release, target, config, remote_dir))
    ssh = ssh_base(config)
    run(*ssh, destination, shlex.join(['mkdir', '-p', remote_dir]))
    rsync = ['rsync', '-a', '-e', rsync_ssh(config)] + config.get('rsync_options', [])
    run(*rsync, stage / 'source' / release['source']['file'], script, destination + ':' + remote_dir + '/')
    log('%s: building (log %s)' % (target, out / 'build.log'))
    with (out / 'build.log').open('w') as stream:
        status = subprocess.run(ssh + [destination, 'bash -l ' + shlex.quote(remote_dir + '/remote-build.sh')],
                                stdout=stream, stderr=subprocess.STDOUT).returncode
    if status != 0:
        raise DeployError('%s: build failed with status %d; see %s' % (target, status, out / 'build.log'))
    run(*rsync, destination + ':' + remote_dir + '/out/', str(out) + '/')
    host = dict(row[:2] for row in parse_tsv(out / 'deploy-host.tsv'))
    debs = []
    for row in parse_tsv(out / 'deploy-debs.tsv'):
        filename, package, version, architecture, sha = row[:5]
        if digest(out / filename) != sha:
            raise DeployError('%s: %s changed in transfer' % (target, filename))
        debs.append({'file': filename, 'package': package, 'version': version, 'architecture': architecture,
                     'sha256': sha, 'size': (out / filename).stat().st_size,
                     'depends': row[5].strip() if len(row) > 5 else ''})
    info = {'target': target, 'kind': 'deb', 'os': host.get('os'), 'kernel': host.get('kernel'),
            'compiler': host.get('compiler'), 'suite': host['suite'], 'architecture': host['arch'],
            'source_sha256': release['source']['sha256'], 'debs': debs, 'built': now()}
    check_linux_build(release, info)
    write_json(out / 'deploy-build.json', info)
    log('%s: built %s' % (target, ', '.join(d['file'] for d in debs)))


def fill_placeholders(text, out):
    def sha(match):
        path = out / match.group(1)
        if not path.is_file():
            raise DeployError('@DEPLOY_SHA256:%s@ names a missing file' % match.group(1))
        return digest(path)
    return re.sub(r'@DEPLOY_SHA256:([^@/]+)@', sha, text)


def build_mac(stage, release, target='localhost'):
    if platform.system() != 'Darwin' or platform.machine() != 'arm64':
        raise DeployError('The Homebrew build must run on Apple Silicon macOS')
    product = platform.mac_ver()[0]
    if product.split('.')[0] != '26':
        raise DeployError('Homebrew artifacts are published as arm64_tahoe; this Mac runs macOS ' + product)
    out = stage / target
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    work = Path(tempfile.mkdtemp(prefix='deploy-mac-%s-' % release['name']))
    source = stage / 'source' / release['source']['file']
    extract_archive(source, work / 'src')
    roots = [p for p in (work / 'src').iterdir() if p.is_dir()]
    if len(roots) != 1:
        raise DeployError('The source archive must contain one top-level directory')
    env = dict(os.environ)
    env.update(hook_environment(release, target, host_config(target)))
    env.update(DEPLOY_OUT=str(out), DEPLOY_WORK=str(work), DEPLOY_SOURCE=str(source), DEPLOY_ARCH='arm64',
               DEPLOY_SUITE='arm64_tahoe', DEPLOY_SELF=str(Path(__file__).resolve()), DEPLOY_REPO=str(ROOT))
    env.setdefault('DEPLOY_JOBS', str(os.cpu_count() or 1))
    script = 'set -euo pipefail\nshopt -s nullglob\n' + SHELL_HELPERS + '\n' + PROJECT['mac_build']
    log('localhost: building (log %s)' % (out / 'build.log'))
    with (out / 'build.log').open('w') as stream:
        status = subprocess.run(['bash', '-c', script], cwd=roots[0], env=env,
                                stdout=stream, stderr=subprocess.STDOUT).returncode
    if status != 0:
        raise DeployError('localhost: build failed with status %d; see %s' % (status, out / 'build.log'))
    shutil.rmtree(work, ignore_errors=True)
    entries = []
    for name, kind in release['brew'].items():
        recipe = out / (name + '.rb')
        if not recipe.is_file():
            raise DeployError('localhost: MAC_BUILD did not write %s.rb' % name)
        text = fill_placeholders(recipe.read_text(), out)
        leftover = re.search(r'@DEPLOY_[A-Z0-9_]+(:[^@]*)?@', text)
        if leftover:
            raise DeployError('localhost: %s.rb still has the placeholder %s' % (name, leftover.group(0)))
        recipe.write_text(text)
        run('ruby', '-c', recipe, stdout=subprocess.DEVNULL)
        is_cask = re.search(r'^\s*cask\s+"', text, re.M) is not None
        if is_cask != (kind == 'cask'):
            raise DeployError('localhost: %s.rb is a %s but BREW says %s'
                              % (name, 'cask' if is_cask else 'formula', kind))
        match = re.search(r'^\s*version\s+"([^"]+)"', text, re.M)
        entries.append({'name': name, 'kind': kind, 'file': recipe.name,
                        'version': match.group(1) if match else release['brew_version']})
    recipes = '\n'.join((out / e['file']).read_text() for e in entries)
    artifacts = []
    for path in sorted(out.iterdir()):
        if not path.is_file() or path.suffix in ('.rb', '.json', '.log', '.sha256'):
            continue
        sha = digest(path)
        if sha not in recipes:
            raise DeployError('localhost: no recipe has the sha256 of %s' % path.name)
        artifacts.append({'file': path.name, 'sha256': sha, 'size': path.stat().st_size})
    info = {'target': target, 'kind': 'brew', 'os': 'macOS ' + product, 'distribution': 'macOS 26 Tahoe',
            'architecture': 'arm64', 'platform_tag': 'arm64_tahoe',
            'compiler': output('cc', '--version').splitlines()[0],
            'source_sha256': release['source']['sha256'], 'brew': entries, 'artifacts': artifacts, 'built': now()}
    write_json(out / 'deploy-build.json', info)
    log('localhost: built', ', '.join([e['file'] for e in entries] + [a['file'] for a in artifacts]))


def command_build(args, stage=None, release=None):
    if stage is None:
        stage, release = load_stage(args)
    release['deb_revision'] = args.deb_revision
    write_json(stage / 'release.json', release)
    targets = args.host or selected_targets(args.skip_host)
    for target in targets:
        if target in unsupported_targets():
            raise DeployError('%s is unsupported for this project: %s' % (target, unsupported_targets()[target]))
    for target, reason in unsupported_targets().items():
        log('skipping %s: %s' % (target, reason))
    if not args.rebuild:
        done = [t for t in targets if (stage / t / 'deploy-build.json').exists() and
                read_json(stage / t / 'deploy-build.json').get('source_sha256') == release['source']['sha256']]
        for target in done:
            log('%s: already built from this source (pass --rebuild to build again)' % target)
        targets = [t for t in targets if t not in done]
    failures = []
    if targets:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(targets)) as pool:
            futures = {}
            for target in targets:
                function = build_mac if target == 'localhost' else build_linux
                futures[pool.submit(function, stage, release, target)] = target
            for future in concurrent.futures.as_completed(futures):
                try:
                    future.result()
                except (DeployError, subprocess.CalledProcessError, OSError, KeyError) as error:
                    failures.append(futures[future])
                    log('FAILED %s: %s' % (futures[future], error))
    if failures:
        raise DeployError('Builds failed: ' + ', '.join(sorted(failures)))
    return stage, release


# ------------------------------------------------------------ stage checks

def validate_stage(stage, release, targets):
    source = stage / 'source' / release['source']['file']
    if digest(source) != release['source']['sha256']:
        raise DeployError('The staged source archive does not match release.json')
    builds = {}
    for target in targets:
        path = stage / target / 'deploy-build.json'
        if not path.exists():
            raise DeployError('%s has not been built; run ./deploy-packages build --host %s' % (target, target))
        info = read_json(path)
        if info['source_sha256'] != release['source']['sha256']:
            raise DeployError('%s was built from a different source; rebuild it' % target)
        for item in info.get('debs', []) + info.get('artifacts', []):
            if digest(stage / target / item['file']) != item['sha256']:
                raise DeployError('%s/%s does not match its build record' % (target, item['file']))
        if info['kind'] == 'deb':
            check_linux_build(release, info)
        elif sorted(e['name'] for e in info['brew']) != sorted(release['brew']):
            raise DeployError('localhost recipes do not match BREW')
        builds[target] = info
    return builds


