#!/bin/sh

. "$(dirname "$0")/e2e-test-subrs"
if ! set_locale; then
    echo "$0: no usable locale" >&2
    exit 99
fi

set -eu

run_local()
{
    client_term=$1
    shift
    TERM="$client_term" \
        ./inpty \
        ../../scripts/adam-mosh \
        --client="../frontend/adam-mosh-client" \
        --server="$PWD/../frontend/adam-mosh-server" \
        --local --bind-server=127.0.0.1 127.0.0.1 \
        -- "$@"
}

out=$(run_local xterm printf 'he%s\n' llo)
case "$out" in
    *hello*) ;;
    *) exit 1;;
esac

out=$(run_local vt100 sh -c 'printf "client TERM: %s\n" "$TERM"')
case "$out" in
    *"client TERM: vt100"*) ;;
    *) exit 1;;
esac

# A command that produces no final terminal update used to enter shutdown
# with an empty reliable queue, then try to append forwarding events after
# TransportSender had frozen its state.  Bound this test so that regression
# fails instead of leaving the test suite hung.
timeout_command=
if command -v timeout > /dev/null 2>&1; then
    timeout_command=timeout
elif command -v gtimeout > /dev/null 2>&1; then
    timeout_command=gtimeout
fi

if test -n "$timeout_command"; then
    TERM=xterm \
        "$timeout_command" 15 \
        ./inpty \
        ../../scripts/adam-mosh \
        --client="../frontend/adam-mosh-client" \
        --server="$PWD/../frontend/adam-mosh-server" \
        --local --bind-server=127.0.0.1 127.0.0.1 \
        -- true > /dev/null
else
    echo "local.test: timeout unavailable; skipping no-output shutdown check" >&2
fi
